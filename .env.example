# For Neon or another hosted PostgreSQL provider, use its pooled connection string.
# Copy the connection string from the provider dashboard; keep this value secret.
DATABASE_URL=

# For local PostgreSQL instead of DATABASE_URL, set these values:
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=scamshield
# PGUSER=postgres
# PGPASSWORD=replace-with-your-postgres-password

# Signs session cookies. Required in production; also encrypts two-factor secrets unless TOTP_ENCRYPTION_KEY is set.
# Changing it signs everyone out and (without TOTP_ENCRYPTION_KEY) breaks existing two-factor setups.
SESSION_SECRET=

# Optional: a separate key for encrypting two-factor (TOTP) secrets at rest.
TOTP_ENCRYPTION_KEY=

# Optional: Google Safe Browsing API key for URL reputation checks (only the scanned URL is sent).
# Without it the URL scanner uses heuristics only and says so.
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional: Twilio Lookup v2 for the Sender Checker's carrier/network and line type (about $0.008 per lookup;
# results are cached for 30 days). Only the phone number is sent. Without these, the checker still uses
# offline country detection and community reports, and says the network is unavailable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional: also request Caller Name (US numbers only, about $0.01 per lookup). Only names the carrier
# marks as a business are shown; private individuals' names are discarded and never stored.
TWILIO_LOOKUP_CALLER_NAME=false
